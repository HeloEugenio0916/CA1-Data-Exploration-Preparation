col = "darkgreen",
pch = 19)
getwd()
list.files()
titanic <- read.csv("https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv")
titanic_data <- titanic[, c("Age", "Fare")]
head(titanic_data)
sum(is.na(titanic_data$Age))
sum(is.na(titanic_data$Fare))
plot(titanic_data$Age, titanic_data$Fare,
main = "Age vs Fare - Original Data",
xlab = "Age",
ylab = "Fare",
col = "red",
pch = 19)
min(titanic_data$Age)
max(titanic_data$Age)
min(titanic_data$Fare)
max(titanic_data$Fare)
age_scaled <- (titanic_data$Age - min(titanic_data$Age)) /
(max(titanic_data$Age) - min(titanic_data$Age))
# Apply Min-Max Scaling to Fare
fare_scaled <- (titanic_data$Fare - min(titanic_data$Fare)) /
(max(titanic_data$Fare) - min(titanic_data$Fare))
# Display the first six scaled ages
head(age_scaled)
# Display the first six scaled fares
head(fare_scaled)
plot(age_scaled, fare_scaled,
main = "Age vs Fare - Scaled Data",
xlab = "Age (Scaled)",
ylab = "Fare (Scaled)",
col = "darkgreen",
pch = 19)
head(fare_scaled)
plot(age_scaled, fare_scaled,
main = "Age vs Fare - Scaled Data",
xlab = "Age (Scaled)",
ylab = "Fare (Scaled)",
col = "darkgreen",
pch = 19)
min(titanic_data$Age)
max(titanic_data$Age)
min(titanic_data$Fare)
max(titanic_data$Fare)
age_scaled <- (titanic_data$Age - min(titanic_data$Age)) /
(max(titanic_data$Age) - min(titanic_data$Age))
fare_scaled <- (titanic_data$Fare - min(titanic_data$Fare)) /
(max(titanic_data$Fare) - min(titanic_data$Fare))
head(age_scaled)
head(fare_scaled)
plot(age_scaled, fare_scaled,
main = "Age vs Fare - Scaled Data",
xlab = "Age (Scaled)",
ylab = "Fare (Scaled)",
col = "darkgreen",
pch = 19)
